# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local
.env.*.local
!.env.example
!.env.local.example
!.env.preview.example
!.env.production.example

# Supabase CLI local link/state (machine-specific; may point at Dev)
supabase/.temp/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local async import file storage
.data/

# Shopify CLI local state
.shopify/
.shopify.lock

# Local demo recording intermediates
demo/*.prev-*.webm
demo/frames-audit/
demo/frames-tmp/
demo/*.rtfd/
