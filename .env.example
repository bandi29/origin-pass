# =============================================================================
# OriginPass — environment variable template
# =============================================================================
# Copy to `.env.local` for local development. NEVER commit `.env.local`.
#
# Target matrix (Supabase):
#   Local (`npm run dev`)     → originpass-dev  (this file / .env.local)
#   Vercel Preview (PRs)      → originpass-dev  (Vercel → Preview scope)
#   Vercel Development (CLI)  → originpass-dev  (Vercel → Development scope)
#   Vercel Production (main)  → originpass      (Vercel → Production scope ONLY)
#
# Production app: https://origin-pass.vercel.app
# Dev project ref:  jmecvwpgfprmlvteiwkh
# Prod project ref: myempzxqncdmobnvgbur
# =============================================================================

# --- Supabase (REQUIRED) — use DEV project keys in .env.local ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-DEV-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-dev-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-dev-supabase-service-role-key

# Optional: Prisma generate / introspection against Dev Postgres
# DATABASE_URL=postgresql://postgres.YOUR-DEV-REF:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# --- App URL ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional: preview plan gating in local/dev (free | pro | enterprise)
# NEXT_PUBLIC_DEV_PLAN=free

# --- Shopify embedded app (Partners / App Store) ---
SHOPIFY_API_KEY=your-shopify-api-key
SHOPIFY_API_SECRET=your-shopify-api-secret
# Alias also supported by webhook HMAC + session token verification:
# SHOPIFY_API_SECRET_KEY=
NEXT_PUBLIC_SHOPIFY_API_KEY=your-shopify-api-key
# SHOPIFY_DEV_STORE=originpass-sandbox.myshopify.com

# --- Google Gemini — AI extraction ---
# Use exactly ONE of: GOOGLE_API_KEY | GEMINI_API_KEY | GOOGLE_AI_API_KEY | GOOGLE_GENERATIVE_AI_API_KEY
# GOOGLE_API_KEY=
# GEMINI_VISION_MODEL=gemini-1.5-flash

# --- OpenAI (optional fallback; images only) ---
# OPENAI_API_KEY=
# OPENAI_VISION_MODEL=
# OPENAI_STORY_MODEL=
# OPENAI_TRANSLATE_MODEL=

# --- Billing (Paddle) ---
# Use test keys locally / on Preview; live keys only on Vercel Production
# PADDLE_API_KEY=api_test_...
# PADDLE_WEBHOOK_SECRET=whsec_...

# --- Imports / storage ---
# IMPORT_USE_SUPABASE_STORAGE=true
# IMPORT_STORAGE_BUCKET=import-uploads
# REDIS_URL=

# --- Security / QR ---
# IP_HASH_SALT=
# QR_SIGNING_SECRET=

# --- Observability (optional) ---
# LOG_LEVEL=info
# OTEL_DISABLED=true
# DIAGNOSTICS_ENABLED=false
